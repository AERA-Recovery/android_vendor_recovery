+// Commands that normally select the built-in KernelSU module can instead use
+// AERA's separate KernelSU provider. Explicit boot-patch -m paths still win.
+#[cfg(all(
+    feature = "aera-external-modules",
+    target_arch = "aarch64",
+    target_os = "android"
+))]
+fn external_module_path(name: &str) -> Option<String> {
+    let kmi = name.strip_suffix("_kernelsu.ko")?;
+    if !list_supported_kmi()
+        .iter()
+        .any(|supported| supported == kmi)
+    {
+        return None;
+    }
+    Some(format!(
+        "/system/etc/aera/root-providers/kernelsu/lkm-aarch64-{name}"
+    ))
 }
 
