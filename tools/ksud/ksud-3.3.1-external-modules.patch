+#[cfg(all(
+    test,
+    feature = "aera-external-modules",
+    target_arch = "aarch64",
+    target_os = "android"
+))]
+mod aera_tests {
+    use super::*;
+
+    #[test]
+    fn keeps_helpers_without_embedded_modules() {
+        assert!(!Asset::iter().any(|name| name.ends_with(".ko")));
+        for helper in ["ksuinit", "busybox", "bootctl", "waitsys"] {
+            assert!(Asset::get(helper).is_some(), "missing helper {helper}");
+        }
+    }
+
+    #[test]
+    fn preserves_supported_kmi_detection() {
+        let supported = list_supported_kmi();
+        assert_eq!(supported.len(), 8);
+        assert_eq!(supported.first().unwrap(), "android12-5.10");
+        assert_eq!(supported.last().unwrap(), "android17-6.18");
+    }
+
+    #[test]
+    fn external_lookup_uses_only_known_module_names() {
+        assert_eq!(
+            external_module_path("android14-6.1_kernelsu.ko").unwrap(),
+            "/system/etc/aera/root-providers/kernelsu/lkm-aarch64-android14-6.1_kernelsu.ko"
+        );
+        assert!(external_module_path("../android14-6.1_kernelsu.ko").is_none());
+        assert!(external_module_path("android99-9.9_kernelsu.ko").is_none());
+        assert!(external_module_path("ksuinit").is_none());
+    }
+}
