+
+// Keep the upstream ARM64 KMI list even though the corresponding module bytes
+// are supplied externally. AERA uses this command to validate KMI detection.
+#[cfg(all(
+    feature = "aera-external-modules",
+    target_arch = "aarch64",
+    target_os = "android"
+))]
+pub fn list_supported_kmi() -> std::vec::Vec<std::string::String> {
+    [
+        "android12-5.10",
+        "android13-5.10",
+        "android13-5.15",
+        "android14-5.15",
+        "android14-6.1",
+        "android15-6.6",
+        "android16-6.12",
+        "android17-6.18",
+    ]
+    .into_iter()
+    .map(String::from)
+    .collect()
+}
